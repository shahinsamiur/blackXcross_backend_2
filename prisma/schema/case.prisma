enum CaseCategory {
  COLD_CASE
  MISSING_PERSON
  UNSOLVED_MURDER
  UNIDENTIFIED_REMAINS
  OTHER
}

enum PublishState {
  DRAFT
  PUBLISHED
}

enum InvestigationStatus {
  OPEN
  CLOSED
  COLD
  SOLVED
}

model Case {
  id                  String              @id @default(uuid())
  title               String
  description         String?
  category            CaseCategory
  publishState        PublishState        @default(DRAFT)
  investigationStatus InvestigationStatus @default(OPEN)
  imageUrl            String?
  narrative           String?
  location            String?
  userId              String
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags                Tag[]               @relation("CaseTags")
  files               CaseFile[]
  theories            Theory[]
  publishedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@map("cases")
}